/**
 * The MongoDB BSON corpus, the types `json::bson` reads.
 *
 * Generated from `source/bson-corpus/tests/*.json` in github.com/mongodb/specifications
 * (Apache-2.0). A valid case parses, and dumps back to its canonical bytes. An int64 that fits
 * in 32 bits comes back as an int32, so those cases compare the tree instead. A decode error is
 * refused. decimal128 is not read yet, so its file is not here.
 */

#[group: "corpus"]
test corpus_array_valid_empty {
    corpusRoundTrips('0d000000046100050000000000');
}

#[group: "corpus"]
test corpus_array_valid_single_element_array {
    corpusRoundTrips('140000000461000c0000001030000a0000000000');
}

#[group: "corpus"]
test corpus_array_valid_single_element_array_with_index_set_incorrectly_to_empty_string {
    corpusRoundTrips('140000000461000c0000001030000a0000000000');
    corpusDegenerate('130000000461000b00000010000a0000000000', '140000000461000c0000001030000a0000000000');
}

#[group: "corpus"]
test corpus_array_valid_single_element_array_with_index_set_incorrectly_to_ab {
    corpusRoundTrips('140000000461000c0000001030000a0000000000');
    corpusDegenerate('150000000461000d000000106162000a0000000000', '140000000461000c0000001030000a0000000000');
}

#[group: "corpus"]
test corpus_array_valid_multi_element_array_with_duplicate_indexes {
    corpusRoundTrips('1b000000046100130000001030000a000000103100140000000000');
    corpusDegenerate('1b000000046100130000001030000a000000103000140000000000', '1b000000046100130000001030000a000000103100140000000000');
}

