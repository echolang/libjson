/**
 * get / at / pick, missing vs JSON null, []= and append.
 */

use ecotest::expect;

#[group: "unit"]
test object_get_and_set {
    json::Value $obj = json::object();
    $obj['name'] = 'mario';
    $obj['age'] = 32;
    $obj['ok'] = true;
    $obj['score'] = 1.5;

    expect($obj['name']->asStr())->some('mario');
    expect($obj['age']->asInt())->some(32); // int32 write widens
    expect($obj['ok']->asBool())->some(true);
    expect($obj['score']->asFloat())->some(1.5);
    expect($obj->count())->is(4);
}

#[group: "unit"]
test an_int64_write_is_an_int {
    json::Value $obj = json::object();
    int64 $big = 9000000000;
    $obj['n'] = $big;

    expect($obj['n']->asInt())->some(9000000000);
}

#[group: "unit"]
test missing_key_is_echo_null {
    json::Value $obj = json::object();
    $obj['present'] = json::nil();

    expect($obj->get('missing'))->none();
    expect(expect($obj->get('present'))->some()->isNull())->yes(says: 'get: JSON null is isNull');
    expect($obj['missing']->isNull())->yes(says: '[]: a missing key reads as JSON null');
    expect($obj['present']->isNull())->yes(says: '[]: a present JSON null is isNull');
    expect($obj->count())->is(1); // a read of a missing key does not insert
}

#[group: "unit"]
test get_on_a_non_object_is_null {
    json::Value $n = json::int(1);

    expect($n->get('x'))->none();
    expect($n->at(0))->none();
}

#[group: "unit"]
test index_on_a_non_container_reads_as_null {
    json::Value $n = json::int(1);

    expect($n['x']->isNull())->yes(says: 'an int has no keys');
    expect($n[0]->isNull())->yes(says: 'an int has no indices');
    expect($n->asInt())->some(1);
}

#[group: "unit"]
test array_append_and_index {
    json::Value $arr = json::arr();
    $arr[] = 'a';
    $arr[] = 2;
    $arr[] = json::bool(false);

    expect($arr->count())->is(3);
    expect($arr[0]->asStr())->some('a');
    expect($arr[1]->asInt())->some(2);
    expect($arr[2]->asBool())->some(false);
    expect($arr->at(3))->none(); // past the end
    expect($arr[3]->isNull())->yes(says: '[]: past the end reads as JSON null');
}

#[group: "unit"]
test array_index_write {
    json::Value $arr = json::arr();
    $arr[] = json::int(1);
    $arr[0] = json::int(9);

    expect(expect($arr->at(0))->some()->asInt())->some(9);
}

#[group: "unit"]
test array_index_write_primitive {
    json::Value $arr = json::arr();
    $arr[] = 1;
    $arr[0] = 9;
    $arr[] = 'x';
    $arr[1] = 'y';

    expect($arr[0]->asInt())->some(9);
    expect($arr[1]->asStr())->some('y');
}

#[group: "unit"]
test pick_walks_object_keys {
    json::Value $addr = json::object();
    $addr['city'] = 'berlin';

    json::Value $user = json::object();
    $user['address'] = $addr;

    expect(expect($user->pick(['address', 'city']))->some()->asStr())->some('berlin');
    expect($user->pick(['address', 'nope']))->none(); // missing leaf
    expect($user->pick(['nope', 'city']))->none(); // missing parent
}

#[group: "unit"]
test missing_key_read_does_not_insert {
    json::Value $obj = json::object();
    string $name = 'missing';

    expect($obj[$name]->isNull())->yes(says: 'the place reads as JSON null');
    expect($obj->count())->is(0);
    expect($obj->get($name))->none();
}

#[group: "unit"]
test chained_append_on_a_nested_array {
    json::Value $user = json::object();
    $user['tags'] = json::arr();
    $user['tags'][] = 'echo';
    $user['tags'][] = 'json';

    expect(json::dump($user))->is('{"tags":["echo","json"]}');
}

#[group: "unit"]
test rewrite_keeps_key_order {
    json::Value $obj = json::object();
    $obj['a'] = json::int(1);
    $obj['b'] = json::int(2);
    $obj['a'] = json::int(3);

    expect(json::dump($obj))->is('{"a":3,"b":2}');
}

#[group: "unit"]
#[tests: expects death]
test index_write_past_the_end_dies {
    json::Value $arr = json::arr();
    $arr[0] = 1;
}

#[group: "unit"]
#[tests: expects death]
test key_write_on_a_non_object_dies {
    json::Value $n = json::int(1);
    $n['x'] = 1;
}

#[group: "unit"]
#[tests: expects death]
test index_write_on_a_non_array_dies {
    json::Value $n = json::int(1);
    $n[0] = 1;
}

#[group: "unit"]
#[tests: expects death]
test append_on_a_non_array_dies {
    json::Value $n = json::int(1);
    $n[] = 1;
}
