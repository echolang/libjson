/**
 * get / at / pick, missing vs JSON null, []= and append.
 */

#[group: "unit"]
test object_get_and_set {
    json::Value $obj = json::object();
    $obj['name'] = 'mario';
    $obj['age'] = 32;
    $obj['ok'] = true;
    $obj['score'] = 1.5;

    string $name = $obj['name']->asStr() ?? '';
    int64 $age = $obj['age']->asInt() ?? 0;
    bool $ok = $obj['ok']->asBool() ?? false;
    float64 $score = $obj['score']->asFloat() ?? 0.0;

    assert($name == 'mario', 'string write');
    assert($age == 32, 'int32 write widens');
    assert($ok == true, 'bool write');
    assert($score == 1.5, 'float write');
    assert($obj->count() == 4, 'four keys');
}

#[group: "unit"]
test missing_key_is_echo_null {
    json::Value $obj = json::object();
    $obj['present'] = json::nil();

    assert($obj->get('missing') == null, 'get: a missing key is Echo null');
    assert($obj->get('present') != null, 'get: a present key is a value');
    assert(($obj->get('present')?->isNull() ?? false) == true, 'get: JSON null is isNull');
    assert($obj['missing']->isNull(), '[]: a missing key reads as JSON null');
    assert($obj['present']->isNull(), '[]: a present JSON null is isNull');
    assert($obj->count() == 1, 'a read of a missing key does not insert');
}

#[group: "unit"]
test get_on_a_non_object_is_null {
    json::Value $n = json::int(1);

    assert($n->get('x') == null, 'int has no keys');
    assert($n->at(0) == null, 'int has no indices');
}

#[group: "unit"]
test array_append_and_index {
    json::Value $arr = json::arr();
    $arr[] = 'a';
    $arr[] = 2;
    $arr[] = json::bool(false);

    assert($arr->count() == 3, 'three elements');
    string $first = $arr[0]->asStr() ?? '';
    int64 $second = $arr[1]->asInt() ?? 0;
    bool $third = $arr[2]->asBool() ?? true;

    assert($first == 'a', 'first');
    assert($second == 2, 'second');
    assert($third == false, 'third');
    assert($arr->at(3) == null, 'at: past the end is Echo null');
    assert($arr[3]->isNull(), '[]: past the end reads as JSON null');
}

#[group: "unit"]
test array_index_write {
    json::Value $arr = json::arr();
    $arr[] = json::int(1);
    $arr[0] = json::int(9);

    assert(($arr->at(0)?->asInt() ?? 0) == 9, 'replaced');
}

#[group: "unit"]
test array_index_write_primitive {
    json::Value $arr = json::arr();
    $arr[] = 1;
    $arr[0] = 9;
    $arr[] = 'x';
    $arr[1] = 'y';

    int64 $n = $arr[0]->asInt() ?? 0;
    string $s = $arr[1]->asStr() ?? '';

    assert($n == 9, 'bare int index write');
    assert($s == 'y', 'bare string index write');
}

#[group: "unit"]
test pick_walks_object_keys {
    json::Value $addr = json::object();
    $addr['city'] = 'berlin';

    json::Value $user = json::object();
    $user['address'] = $addr;

    json::Value? $city = $user->pick(['address', 'city']);

    assert(($city?->asStr() ?? '') == 'berlin', 'picked city');
    assert($user->pick(['address', 'nope']) == null, 'missing leaf');
    assert($user->pick(['nope', 'city']) == null, 'missing parent');
}

#[group: "unit"]
test missing_key_read_does_not_insert {
    json::Value $obj = json::object();
    string $name = 'missing';

    assert($obj[$name]->isNull(), 'the place reads as JSON null');
    assert($obj->count() == 0, 'a read of a missing key does not insert');
    assert($obj->get($name) == null, 'get still says missing');
}

#[group: "unit"]
test chained_append_on_a_nested_array {
    json::Value $user = json::object();
    $user['tags'] = json::arr();
    $user['tags'][] = 'echo';
    $user['tags'][] = 'json';

    assert(json::dump($user) == '{"tags":["echo","json"]}', 'append through a read of the array');
}

#[group: "unit"]
test rewrite_keeps_key_order {
    json::Value $obj = json::object();
    $obj['a'] = json::int(1);
    $obj['b'] = json::int(2);
    $obj['a'] = json::int(3);

    assert(json::dump($obj) == '{"a":3,"b":2}', 'rewrite does not move the key');
}
