/**
 * RFC 8259 fixtures, errors, nesting, unicode.
 */

use ecotest::expect;

/**
 * The case name of a refusal, so a check prints `expected unterminated, got unexpected`.
 */
function kind(const json::Error& $e) : string
{
    return match ($e) {
        json::Error::unexpected($at) => 'unexpected',
        json::Error::unterminated($at) => 'unterminated',
        json::Error::badEscape($at) => 'badEscape',
        json::Error::badUtf8($at) => 'badUtf8',
        json::Error::badNumber($at) => 'badNumber',
        json::Error::tooBig($at) => 'tooBig',
        json::Error::tooDeep($at) => 'tooDeep',
        json::Error::trailing($at) => 'trailing',
        json::Error::empty($at) => 'empty',
    };
}

/**
 * How `$text` was refused, or `ok` when it parsed.
 */
function fault(const string& $text) : string
{
    result<json::Value, json::Error> $r = json::parse($text);

    if ($r->has_value()) {
        return 'ok';
    }

    return kind($r->failure());
}

#[group: "unit"]
test parses_scalars {
    expect(expect(json::parse('null'))->ok()->isNull())->yes(says: 'null');
    expect(expect(json::parse('true'))->ok()->asBool())->some(true);
    expect(expect(json::parse('false'))->ok()->asBool())->some(false);
    expect(expect(json::parse('42'))->ok()->asInt())->some(42);
    expect(expect(json::parse('-7'))->ok()->asInt())->some(-7);
    expect(expect(json::parse('0'))->ok()->asInt())->some(0);
    expect(expect(json::parse('"hi"'))->ok()->asStr())->some('hi');
}

#[group: "unit"]
test parses_surrounding_whitespace {
    json::Value $v = expect(json::parse("  \n\ttrue\r\n  "))->ok();

    expect($v->asBool())->some(true);
}

#[group: "unit"]
test parses_an_array {
    json::Value $v = expect(json::parse('[1, "a", false, null]'))->ok();

    expect($v->isArray())->yes(says: 'array');
    expect($v->count())->is(4);
    expect($v[0]->asInt())->some(1);
    expect($v[1]->asStr())->some('a');
    expect($v[2]->asBool())->some(false);
    expect($v[3]->isNull())->yes(says: 'fourth is JSON null');
}

#[group: "unit"]
test parses_an_object {
    json::Value $v = expect(json::parse('{"name":"echo","n":1}'))->ok();

    expect($v->isObject())->yes(says: 'object');
    expect($v['name']->asStr())->some('echo');
    expect($v['n']->asInt())->some(1);
}

#[group: "unit"]
test last_duplicate_key_wins {
    json::Value $v = expect(json::parse('{"a":1,"a":2}'))->ok();

    expect($v['a']->asInt())->some(2);
    expect(json::dump($v))->is('{"a":2}');
}

#[group: "unit"]
test number_with_fraction_is_float {
    json::Value $v = expect(json::parse('1.5'))->ok();

    expect($v->isFloat())->yes(says: 'fraction is float');
    expect($v->asFloat())->some(1.5);
}

#[group: "unit"]
test number_with_exponent_is_float {
    json::Value $v = expect(json::parse('1e2'))->ok();

    expect($v->isFloat())->yes(says: 'exponent is float');
    expect($v->asFloat())->some(100.0);
}

#[group: "unit"]
test empty_containers {
    json::Value $a = expect(json::parse('[]'))->ok();
    json::Value $o = expect(json::parse('{}'))->ok();

    expect($a->isArray())->yes(says: 'empty array');
    expect($o->isObject())->yes(says: 'empty object');
    expect($a->count())->is(0);
    expect($o->count())->is(0);
}

#[group: "unit"]
test string_escapes {
    expect(expect(json::parse('"\\""'))->ok()->asStr())->some('"');
    expect(expect(json::parse('"\\\\"'))->ok()->asStr())->some('\\');
    expect(expect(json::parse('"\\/"'))->ok()->asStr())->some('/');
    expect(expect(json::parse('"\\n"'))->ok()->asStr())->some("\n");
    expect(expect(json::parse('"\\t"'))->ok()->asStr())->some("\t");
}

#[group: "unit"]
test unicode_escape {
    expect(expect(json::parse('"\\u00e4"'))->ok()->asStr())->some('ä');
}

#[group: "unit"]
test surrogate_pair {
    string $got = expect(expect(json::parse('"\\uD83D\\uDE00"'))->ok()->asStr())->some();

    expect($got)->length(4);
    expect($got->byte(0))->is(240);
    expect($got->byte(1))->is(159);
    expect($got->byte(2))->is(152);
    expect($got->byte(3))->is(128);
}

#[group: "unit"]
test raw_utf8_in_a_string {
    expect(expect(json::parse('"ä"'))->ok()->asStr())->some('ä');
}

#[group: "unit"]
test empty_input_is_empty {
    expect(fault(''))->is('empty');
}

#[group: "unit"]
test whitespace_only_is_empty {
    expect(fault("  \n\t"))->is('empty');
}

#[group: "unit"]
test trailing_data {
    expect(fault('true false'))->is('trailing');
}

#[group: "unit"]
test unterminated_string {
    expect(fault('"hi'))->is('unterminated');
}

#[group: "unit"]
test unexpected_token {
    expect(fault(']'))->is('unexpected');
}

#[group: "unit"]
test leading_zero_is_bad_number {
    expect(fault('01'))->is('badNumber');
}

#[group: "unit"]
test trailing_comma {
    expect(fault('[1,]'))->is('unexpected');
}

#[group: "unit"]
test integer_overflow_is_too_big {
    json::Error $e = expect(json::parse('9223372036854775808'))->fails();

    expect(kind($e))->is('tooBig');
    expect($e->column())->is(1);
}

#[group: "unit"]
test lone_surrogate {
    expect(fault('"\\uD800"'))->is('badEscape');
}

#[group: "unit"]
test comments_are_refused {
    expect(fault('{"a":1 /* no */}'))->is('unexpected');
}

#[group: "unit"]
test error_carries_a_place {
    json::Error $e = expect(json::parse("[\n  1,\n  #"))->fails();

    expect($e->line())->is(3);
    expect($e->column())->is(3);
}

#[group: "unit"]
test nesting_cap {
    string $deep = '';
    int32 $i = 0;

    while ($i < 129) {
        $deep->push(91);
        $i = $i + 1;
    }

    $i = 0;

    while ($i < 129) {
        $deep->push(93);
        $i = $i + 1;
    }

    expect(fault($deep))->is('tooDeep');
}

#[group: "unit"]
test round_trip_identity {
    json::Value $v = expect(json::parse('{"a":[1,true,null,"x"],"b":1.5}'))->ok();
    string $out = json::dump($v);
    json::Value $again = expect(json::parse($out))->ok();

    expect(json::dump($again))->is($out);
}

#[group: "unit"]
test interpolation_of_an_error {
    json::Error $e = expect(json::parse(''))->fails();

    expect("{$e}")->starts('empty input at ');
}

#[group: "unit"]
test advance_at_the_end_stays_put {
    json::Parser $p = json::Parser('');

    $p->advance();

    expect($p->i)->is(0);
    expect($p->column)->is(1);
}
