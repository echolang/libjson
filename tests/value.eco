/**
 * Constructors, extractors, clone sharing.
 */

use ecotest::expect;

#[group: "unit"]
test nil_is_null {
    json::Value $v = json::nil();

    expect($v->isNull())->yes(says: 'nil is null');
    expect($v->isBool())->no(says: 'nil is not a bool');
    expect($v->asStr())->none();
}

#[group: "unit"]
test bool_round_trips {
    json::Value $t = json::bool(true);
    json::Value $f = json::bool(false);

    expect($t->isBool())->yes(says: 'true is a bool');
    expect($t->asBool())->some(true);
    expect($f->asBool())->some(false);
    expect($t->asInt())->none();
}

#[group: "unit"]
test int_and_float {
    json::Value $n = json::int(42);
    json::Value $f = json::float(1.5);

    expect($n->isInt())->yes(says: '42 is an int');
    expect($n->isNumber())->yes(says: '42 is a number');
    expect($n->asInt())->some(42);
    expect($n->asFloat())->some(42.0); // an int widens
    expect($f->isFloat())->yes(says: '1.5 is a float');
    expect($f->isNumber())->yes(says: '1.5 is a number');
    expect($f->asInt())->none();
    expect($f->asFloat())->some(1.5);
}

#[group: "unit"]
test str_comes_back {
    json::Value $s = json::str('hello');

    expect($s->isStr())->yes(says: 'it is a string');
    expect($s->asStr())->some('hello');
}

#[group: "unit"]
test extractors_refuse_the_wrong_kind {
    json::Value $s = json::str('1');

    expect($s->asBool())->none();
    expect($s->asFloat())->none();
    expect($s->asArray())->none();
    expect($s->asObject())->none();
    expect($s->isNumber())->no(says: 'a string is not a number');
    expect($s->count())->is(0);
}

#[group: "unit"]
test empty_array_and_object {
    json::Value $a = json::arr();
    json::Value $o = json::object();

    expect($a->isArray())->yes(says: 'empty array');
    expect($o->isObject())->yes(says: 'empty object');
    expect($a->count())->is(0);
    expect($o->count())->is(0);
}

#[group: "unit"]
test as_array_is_a_copy_of_the_list {
    json::Value $a = json::arr();
    $a[] = 1;
    $a[] = 'two';

    array<json::Value> $items = expect($a->asArray())->some();

    expect($items->count())->is(2);
    expect($items[0]->asInt())->some(1);
    expect($items[1]->asStr())->some('two');

    $items[] = json::int(3);

    expect($a->count())->is(2); // the list itself did not grow
}

#[group: "unit"]
test as_object_is_a_copy_of_the_map {
    json::Value $o = json::object();
    $o['a'] = 1;
    $o['b'] = true;

    ordered_map<string, json::Value> $fields = expect($o->asObject())->some();

    expect($fields->keys())->is(['a', 'b']);
    expect($fields->get('a')->asInt())->some(1);
    expect($fields->get('b')->asBool())->some(true);
}

#[group: "unit"]
test assignment_shares {
    json::Value $a = json::object();
    $a['x'] = json::int(1);

    json::Value $b = $a;
    $b['x'] = json::int(2);

    expect($a['x']->asInt())->some(2);
}

#[group: "unit"]
test clone_is_a_deep_copy {
    json::Value $a = json::object();
    $a['x'] = json::int(1);

    json::Value $b = $a->clone();
    $b['x'] = json::int(2);

    expect($a['x']->asInt())->some(1); // the original is untouched
    expect($b['x']->asInt())->some(2);
}

#[group: "unit"]
test clone_copies_arrays_all_the_way_down {
    json::Value $inner = json::object();
    $inner['n'] = 1;

    json::Value $a = json::arr();
    $a[] = $inner;
    $a[] = 'x';

    json::Value $b = $a->clone();
    $b[0]['n'] = 2;
    $b[] = 'y';

    expect(json::dump($a))->is('[{"n":1},"x"]');
    expect(json::dump($b))->is('[{"n":2},"x","y"]');
}

#[group: "unit"]
test leading_dot_constructors {
    json::Value $v = .nil();

    expect($v->isNull())->yes(says: 'dot nil');

    json::Value $n = .int(7);

    expect($n->asInt())->some(7);

    json::Value $a = .array();

    expect($a->isArray())->yes(says: 'dot array does not hide array<T>');
}
