/**
 * Hostile and malformed input: broken punctuation, truncated tokens at EOF,
 * integer / float overflow, nesting at the cap, and invalid UTF-8.
 *
 * `fault` / `kind` live in parse.eco (same module).
 */

use ecotest::expect;

function edgeQuote(const string& $inner) : string
{
    string $out = '';

    $out->push(34);
    $out->append($inner);
    $out->push(34);

    return $out;
}

function edgeBytes(int32 $a) : string
{
    string $s = '';
    uint8 $b = $a;

    $s->push($b);

    return $s;
}

function edgeBytes2(int32 $a, int32 $b) : string
{
    string $s = edgeBytes($a);
    uint8 $u = $b;

    $s->push($u);

    return $s;
}

function edgeBytes3(int32 $a, int32 $b, int32 $c) : string
{
    string $s = edgeBytes2($a, $b);
    uint8 $u = $c;

    $s->push($u);

    return $s;
}

function edgeBytes4(int32 $a, int32 $b, int32 $c, int32 $d) : string
{
    string $s = edgeBytes3($a, $b, $c);
    uint8 $u = $d;

    $s->push($u);

    return $s;
}

function edgeRepeat(int32 $b, int32 $n) : string
{
    string $s = '';
    int32 $i = 0;
    uint8 $u = $b;

    while ($i < $n) {
        $s->push($u);
        $i = $i + 1;
    }

    return $s;
}

function edgeJoin(const string& $a, const string& $b) : string
{
    string $s = $a;

    $s->append($b);

    return $s;
}

// ---- broken json -------------------------------------------------------------------------------

#[group: "unit"]
test unterminated_containers {
    expect(fault('['))->is('unterminated'); // bare [
    expect(fault('[1'))->is('unterminated'); // array missing ]
    expect(fault('[1,'))->is('unterminated'); // array trailing comma then EOF
    expect(fault('{'))->is('unterminated'); // bare {
    expect(fault('{"a"'))->is('unterminated'); // object missing colon
    expect(fault('{"a":'))->is('unterminated'); // object missing value
    expect(fault('{"a":1'))->is('unterminated'); // object missing }
}

#[group: "unit"]
test mismatched_brackets {
    expect(fault('[}'))->is('unexpected'); // [}
    expect(fault('{]'))->is('unexpected'); // {]
    expect(fault('{"a":1]'))->is('unexpected'); // object closed with ]
    expect(fault('[1}'))->is('unexpected'); // array closed with }
    expect(fault('[]}'))->is('trailing'); // extra } after array
    expect(fault('{}]'))->is('trailing'); // extra ] after object
}

#[group: "unit"]
test missing_punctuation {
    expect(fault('[1 2]'))->is('unexpected'); // array missing comma
    expect(fault('{"a":1 "b":2}'))->is('unexpected'); // object missing comma
    expect(fault('{"a" 1}'))->is('unexpected'); // missing colon
    expect(fault('{"a"::1}'))->is('unexpected'); // double colon
    expect(fault('[1:2]'))->is('unexpected'); // colon in array
    expect(fault('{1:2}'))->is('unexpected'); // number as object key
    expect(fault('{a:1}'))->is('unexpected'); // unquoted key
}

#[group: "unit"]
test extra_commas_and_colons {
    expect(fault('[,]'))->is('unexpected'); // empty array slot
    expect(fault('[1,,2]'))->is('unexpected'); // double comma
    expect(fault('{,}'))->is('unexpected'); // object starting with comma
    expect(fault('{"a":1,}'))->is('unexpected'); // trailing comma in object
    expect(fault('{"a":}'))->is('unexpected'); // missing value after colon
    expect(fault('[:]'))->is('unexpected'); // colon as array element
}

#[group: "unit"]
test not_json_at_all {
    expect(fault("'hi'"))->is('unexpected'); // single quotes
    expect(fault('hello'))->is('unexpected'); // bare identifier
    expect(fault('# no'))->is('unexpected'); // hash comment
    expect(fault('// no'))->is('unexpected'); // line comment
    expect(fault('True'))->is('unexpected'); // capital True
    expect(fault('FALSE'))->is('unexpected'); // capital FALSE
    expect(fault('NULL'))->is('unexpected'); // capital NULL
    expect(fault('NaN'))->is('unexpected'); // NaN
    expect(fault('Infinity'))->is('unexpected'); // Infinity
    expect(fault('+1'))->is('unexpected'); // leading plus
}

#[group: "unit"]
test broken_literals {
    expect(fault('n'))->is('unterminated'); // n
    expect(fault('nu'))->is('unterminated'); // nu
    expect(fault('nul'))->is('unterminated'); // nul
    expect(fault('t'))->is('unterminated'); // t
    expect(fault('tr'))->is('unterminated'); // tr
    expect(fault('tru'))->is('unterminated'); // tru
    expect(fault('f'))->is('unterminated'); // f
    expect(fault('fal'))->is('unterminated'); // fal
    expect(fault('fals'))->is('unterminated'); // fals
    expect(fault('nuxx'))->is('unexpected'); // nuxx
    expect(fault('trux'))->is('unexpected'); // trux
    expect(fault('fulse'))->is('unexpected'); // fulse
    expect(fault('truex'))->is('trailing'); // truex
    expect(fault('nullx'))->is('trailing'); // nullx
    expect(fault('falsex'))->is('trailing'); // falsex
}

#[group: "unit"]
test two_top_level_values {
    expect(fault('1 2'))->is('trailing'); // two numbers
    expect(fault('{}[]'))->is('trailing'); // object then array
    expect(fault('"a""b"'))->is('trailing'); // two strings
    expect(fault('true\nfalse'))->is('trailing'); // true then false
}

// ---- numbers -----------------------------------------------------------------------------------

#[group: "unit"]
test broken_number_spellings {
    expect(fault('-'))->is('badNumber'); // lone minus
    expect(fault('--1'))->is('badNumber'); // double minus
    expect(fault('-Infinity'))->is('badNumber'); // minus Infinity
    expect(fault('.5'))->is('unexpected'); // leading dot
    expect(fault('1.'))->is('badNumber'); // trailing dot
    expect(fault('1e'))->is('badNumber'); // exponent missing digits
    expect(fault('1e+'))->is('badNumber'); // exponent plus missing digits
    expect(fault('1e-'))->is('badNumber'); // exponent minus missing digits
    expect(fault('00'))->is('badNumber'); // double zero
    expect(fault('-01'))->is('badNumber'); // negative leading zero
    expect(fault('01.5'))->is('badNumber'); // leading zero before fraction
    expect(fault('1.2.3'))->is('trailing'); // two dots
    expect(fault('1e2e3'))->is('trailing'); // two exponents
    expect(fault('0x1'))->is('trailing'); // hex prefix
    expect(fault('1+2'))->is('trailing'); // plus in the middle
}

#[group: "unit"]
test integer_limits {
    expect(expect(json::parse('9223372036854775807'))->ok()->asInt())->some(9223372036854775807);
    expect(expect(json::parse('-9223372036854775808'))->ok()->asInt())->some(-9223372036854775808);
    expect(expect(json::parse('-0'))->ok()->asInt())->some(0); // negative zero is int 0
    expect(fault('9223372036854775808'))->is('tooBig'); // int64 max plus one
    expect(fault('-9223372036854775809'))->is('tooBig'); // int64 min minus one
    expect(fault(edgeRepeat(57, 80)))->is('tooBig'); // 80 nines
}

#[group: "unit"]
test float_spellings_and_limits {
    json::Value $a = expect(json::parse('1e+2'))->ok();

    expect($a->isFloat())->yes(says: '1e+2 is float');
    expect($a->asFloat())->some(100.0);

    json::Value $b = expect(json::parse('1E-2'))->ok();

    expect($b->isFloat())->yes(says: '1E-2 is float');
    expect($b->asFloat())->some(0.01);

    json::Value $c = expect(json::parse('0e0'))->ok();

    expect($c->isFloat())->yes(says: '0e0 is float');
    expect($c->asFloat())->some(0.0);

    json::Value $d = expect(json::parse('-0.0'))->ok();

    expect($d->isFloat())->yes(says: '-0.0 is float');
    expect($d->asFloat())->some(0.0);

    json::Value $tiny = expect(json::parse('1e-400'))->ok();

    expect($tiny->isFloat())->yes(says: 'underflow stays a float');
    expect($tiny->asFloat())->some(0.0);

    expect(expect(json::parse('1e308'))->ok()->isFloat())->yes(says: '1e308 is still in range');
    expect(fault('1e309'))->is('tooBig'); // 1e309 overflows float64
    expect(fault('-1e309'))->is('tooBig'); // -1e309 overflows float64
    expect(fault('1e400'))->is('tooBig'); // 1e400 overflows float64
}

// ---- truncated input / no walk past the last byte ----------------------------------------------

#[group: "unit"]
test truncated_string_and_escape_at_eof {
    expect(fault('"'))->is('unterminated'); // opening quote only
    expect(fault('"\\'))->is('unterminated'); // backslash at EOF
    expect(fault('"\\u'))->is('unterminated'); // \u at EOF
    expect(fault('"\\u0'))->is('unterminated'); // \u0 at EOF
    expect(fault('"\\u00'))->is('unterminated'); // \u00 at EOF
    expect(fault('"\\u000'))->is('unterminated'); // \u000 at EOF
    expect(fault('"\\uD800'))->is('badEscape'); // high surrogate then EOF
    expect(fault('"\\uD800\\'))->is('unterminated'); // high surrogate, backslash, EOF
    expect(fault('"\\uD800\\u'))->is('unterminated'); // high surrogate, \u, EOF
    expect(fault('"\\uD800\\uD'))->is('unterminated'); // high surrogate, partial low, EOF
}

#[group: "unit"]
test truncated_utf8_at_eof {
    // " + lead, no continuation, no closing quote
    expect(fault(edgeQuote(edgeBytes(194))->sub(0, 2)))->is('badUtf8'); // truncated 2-byte then EOF
    expect(fault(edgeQuote(edgeBytes2(226, 130))->sub(0, 3)))->is('badUtf8'); // truncated 3-byte then EOF
    expect(fault(edgeQuote(edgeBytes3(240, 159, 152))->sub(0, 4)))->is('badUtf8'); // truncated 4-byte then EOF
}

// ---- bad utf-8 ---------------------------------------------------------------------------------

#[group: "unit"]
test isolated_continuation_bytes {
    expect(fault(edgeQuote(edgeBytes(128))))->is('badUtf8'); // 0x80
    expect(fault(edgeQuote(edgeBytes(191))))->is('badUtf8'); // 0xbf
}

#[group: "unit"]
test truncated_multibyte_inside_string {
    expect(fault(edgeQuote(edgeBytes(194))))->is('badUtf8'); // 2-byte lead only
    expect(fault(edgeQuote(edgeBytes2(226, 130))))->is('badUtf8'); // 3-byte missing last
    expect(fault(edgeQuote(edgeBytes3(240, 159, 152))))->is('badUtf8'); // 4-byte missing last
    expect(fault(edgeQuote(edgeBytes2(194, 32))))->is('badUtf8'); // 2-byte with space continuation
    expect(fault(edgeQuote(edgeBytes2(194, 255))))->is('badUtf8'); // 2-byte with 0xff continuation
}

#[group: "unit"]
test overlong_utf8 {
    expect(fault(edgeQuote(edgeBytes2(192, 128))))->is('badUtf8'); // overlong NUL C0 80
    expect(fault(edgeQuote(edgeBytes2(193, 191))))->is('badUtf8'); // overlong C1 BF
    expect(fault(edgeQuote(edgeBytes3(224, 128, 128))))->is('badUtf8'); // overlong 3-byte NUL
    expect(fault(edgeQuote(edgeBytes4(240, 128, 128, 128))))->is('badUtf8'); // overlong 4-byte NUL
}

#[group: "unit"]
test utf8_encoded_surrogates {
    expect(fault(edgeQuote(edgeBytes3(237, 160, 128))))->is('badUtf8'); // U+D800 as UTF-8
    expect(fault(edgeQuote(edgeBytes3(237, 176, 128))))->is('badUtf8'); // U+DC00 as UTF-8
    expect(fault(edgeQuote(edgeBytes3(237, 191, 191))))->is('badUtf8'); // U+DFFF as UTF-8
}

#[group: "unit"]
test utf8_out_of_range {
    expect(fault(edgeQuote(edgeBytes(248))))->is('badUtf8'); // 5-byte lead 0xf8
    expect(fault(edgeQuote(edgeBytes(255))))->is('badUtf8'); // 0xff
    expect(fault(edgeQuote(edgeBytes4(244, 144, 128, 128))))->is('badUtf8'); // U+110000
    expect(fault(edgeQuote(edgeBytes4(245, 128, 128, 128))))->is('badUtf8'); // lead 0xf5
    expect(expect(json::parse(edgeQuote(edgeBytes(255))))->fails()->message())->starts('invalid UTF-8 at ');
}

#[group: "unit"]
test high_byte_outside_a_string {
    expect(fault(edgeBytes(128)))->is('unexpected'); // 0x80 as a token
    expect(fault(edgeBytes(255)))->is('unexpected'); // 0xff as a token
    expect(fault(edgeBytes3(239, 187, 191)))->is('unexpected'); // UTF-8 BOM at start
}

#[group: "unit"]
test valid_multibyte_utf8 {
    expect(expect(json::parse(edgeQuote(edgeBytes2(195, 164))))->ok()->asStr())->some('ä');

    string $euro = expect(expect(json::parse(edgeQuote(edgeBytes3(226, 130, 172))))->ok()->asStr())->some();

    expect($euro)->length(3);
    expect($euro->byte(0))->is(226);
    expect($euro->byte(1))->is(130);
    expect($euro->byte(2))->is(172);

    string $grin = expect(expect(json::parse(edgeQuote(edgeBytes4(240, 159, 152, 128))))->ok()->asStr())->some();

    expect($grin)->length(4);
    expect($grin->byte(0))->is(240);

    string $max = expect(expect(json::parse(edgeQuote(edgeBytes4(244, 143, 191, 191))))->ok()->asStr())->some();

    expect($max)->length(4); // U+10FFFF
    expect($max->byte(0))->is(244);
}

// ---- unicode escapes ---------------------------------------------------------------------------

#[group: "unit"]
test bad_unicode_escapes {
    expect(fault('"\\x00"'))->is('badEscape'); // \x is not an escape
    expect(fault('"\\a"'))->is('badEscape'); // \a is not an escape
    expect(fault('"\\v"'))->is('badEscape'); // \v is not an escape
    expect(fault('"\\u00zz"'))->is('badEscape'); // non-hex in \u
    expect(fault('"\\u00G0"'))->is('badEscape'); // G is not hex
    expect(fault('"\\U0000"'))->is('badEscape'); // capital U
    expect(fault('"\\uDC00"'))->is('badEscape'); // lone low surrogate
    expect(fault('"\\ud800"'))->is('badEscape'); // lowercase lone high
    expect(fault('"\\uD800\\uD800"'))->is('badEscape'); // high then high
    expect(fault('"\\uD800\\u0041"'))->is('badEscape'); // high then non-surrogate
    expect(fault('"\\uD800X"'))->is('badEscape'); // high then ASCII
}

#[group: "unit"]
test unicode_escape_edges {
    string $nul = expect(expect(json::parse('"\\u0000"'))->ok()->asStr())->some();

    expect($nul)->length(1);
    expect($nul->byte(0))->is(0);

    expect(expect(json::parse('"\\u00E4"'))->ok()->asStr())->some('ä'); // uppercase hex

    expect(expect(expect(json::parse('"\\uD7FF"'))->ok()->asStr())->some())->length(3); // last BMP before surrogates
    expect(expect(expect(json::parse('"\\uE000"'))->ok()->asStr())->some())->length(3); // first BMP after surrogates
    expect(expect(expect(json::parse('"\\uFFFF"'))->ok()->asStr())->some())->length(3); // U+FFFF is a valid scalar

    string $max = expect(expect(json::parse('"\\uDBFF\\uDFFF"'))->ok()->asStr())->some();

    expect($max)->length(4); // U+10FFFF via surrogates
    expect($max->byte(0))->is(244);
    expect($max->byte(1))->is(143);
    expect($max->byte(2))->is(191);
    expect($max->byte(3))->is(191);
}

#[group: "unit"]
test remaining_escapes {
    expect(expect(json::parse('"\\b"'))->ok()->asStr())->some(edgeBytes(8));
    expect(expect(json::parse('"\\f"'))->ok()->asStr())->some(edgeBytes(12));
    expect(expect(json::parse('"\\r"'))->ok()->asStr())->some(edgeBytes(13));
    expect(json::dump(expect(json::parse('"\\b\\f\\r"'))->ok()))->is('"\\b\\f\\r"');
}

// ---- controls and whitespace -------------------------------------------------------------------

#[group: "unit"]
test unescaped_controls_in_strings {
    expect(fault(edgeQuote(edgeBytes(0))))->is('unexpected'); // NUL in string
    expect(fault(edgeQuote(edgeBytes(1))))->is('unexpected'); // 0x01 in string
    expect(fault(edgeQuote(edgeBytes(9))))->is('unexpected'); // tab in string
    expect(fault(edgeQuote(edgeBytes(10))))->is('unexpected'); // LF in string
    expect(fault(edgeQuote(edgeBytes(13))))->is('unexpected'); // CR in string
    expect(fault(edgeQuote(edgeBytes(31))))->is('unexpected'); // 0x1f in string
}

#[group: "unit"]
test del_is_allowed_in_a_string {
    expect(expect(json::parse(edgeQuote(edgeBytes(127))))->ok()->asStr())->some(edgeBytes(127));
}

#[group: "unit"]
test form_feed_is_not_whitespace {
    expect(fault(edgeBytes(12)))->is('unexpected'); // bare form feed

    string $padded = '';

    $padded->push(12);
    $padded->append('1');

    expect(fault($padded))->is('unexpected'); // form feed then number
}

#[group: "unit"]
test cr_is_whitespace {
    json::Value $v = expect(json::parse("[\r1\r,\r2\r]"))->ok();

    expect($v->isArray())->yes(says: 'CR-separated array');
    expect($v->count())->is(2);
}

#[group: "unit"]
test dump_generic_control {
    string $inner = '';

    $inner->push(1);

    expect(json::dump(json::str($inner)))->is('"\\u0001"');
}

// ---- nesting / long input ----------------------------------------------------------------------

#[group: "unit"]
test nesting_exactly_max {
    string $deep = edgeJoin(edgeRepeat(91, 128), edgeRepeat(93, 128));

    expect(expect(json::parse($deep))->ok()->isArray())->yes(says: '128 arrays is allowed');
}

#[group: "unit"]
test nesting_cap_objects {
    string $deep = '';
    int32 $i = 0;

    while ($i < 129) {
        $deep->append('{"x":');
        $i = $i + 1;
    }

    $deep->append('1');
    $i = 0;

    while ($i < 129) {
        $deep->push(125);
        $i = $i + 1;
    }

    expect(fault($deep))->is('tooDeep'); // 129 objects
}

#[group: "unit"]
test long_string_round_trips {
    string $inner = edgeRepeat(97, 4096);
    json::Value $v = expect(json::parse(edgeQuote($inner)))->ok();

    expect(expect($v->asStr())->some())->length(4096);
    expect(json::dump($v))->is(edgeQuote($inner));
}

#[group: "unit"]
test long_number_token_is_too_big {
    string $token = edgeJoin('1', edgeRepeat(48, 200));

    expect(fault($token))->is('tooBig'); // 201-digit integer
}

#[group: "unit"]
test empty_string_and_empty_key {
    expect(expect(json::parse('""'))->ok()->asStr())->some('');

    json::Value $v = expect(json::parse('{"":1}'))->ok();

    expect(expect($v->get(''))->some()->asInt())->some(1);
    expect(json::dump($v))->is('{"":1}');
}

#[group: "unit"]
test unicode_object_key {
    json::Value $v = expect(json::parse('{"ä":1}'))->ok();

    expect(expect($v->get('ä'))->some()->asInt())->some(1); // raw utf-8 key

    json::Value $u = expect(json::parse('{"\\u00e4":2}'))->ok();

    expect(expect($u->get('ä'))->some()->asInt())->some(2); // escaped utf-8 key
}

#[group: "unit"]
test bad_escape_in_an_object_key {
    expect(fault('{"\\x":1}'))->is('badEscape');
}

#[group: "unit"]
test high_surrogate_then_another_escape {
    expect(fault('"\\uD800\\n"'))->is('badEscape');
}

#[group: "unit"]
test error_offset_on_truncated_escape {
    json::Error $e = expect(json::parse('"\\u00'))->fails();

    expect(kind($e))->is('unterminated');
    expect($e->line())->is(1);
    expect($e->column())->is(6); // sits on EOF
    expect($e->offset())->is(5);
}

// ---- utf-8 helpers -----------------------------------------------------------------------------

#[group: "unit"]
test decode_past_the_end_is_not_ok {
    json::Utf8Step $step = json::decodeAt('a', 1);

    expect($step->ok)->no(says: 'nothing left to decode');
    expect($step->len)->is(0);
}

#[group: "unit"]
test decode_ascii_is_one_byte {
    json::Utf8Step $step = json::decodeAt('a', 0);

    expect($step->ok)->yes(says: 'ASCII decodes');
    expect($step->len)->is(1);
    expect($step->cp)->is(97);
    expect(json::utf8LeadWidth(97))->is(1);
}
