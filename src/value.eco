/**
 * One JSON value.
 *
 * An enum, so a number is not as wide as an object. Arrays and objects share through a small class
 * box: `$b = $a; $b['x'] = 1;` mutates `$a` too. That is the PHP / JS bargain, and it is the one
 * that makes `$obj['name'] = ...` a real write rather than a copy you throw away. `clone()` is the
 * deep copy, written out so sharing is never implied by `=`.
 *
 * `Items` and `Fields` own the container operations. `Value` is a match that forwards.
 *
 * JSON `null` is `json::nil()`. `null` is reserved in Echo, so the function cannot take that name;
 * `isNull()` still asks the question, because that identifier is a different word. An empty array
 * is `json::arr()`, not `json::array()`: `array` is already the container type.
 */

namespace json;

class Items
{
    private array<Value> $vals;

    internal constructor()
    {
        $this->vals = array<Value>();
    }

    internal const function count() : usize
    {
        return $this->vals->count();
    }

    internal const function value(usize $i) : Value
    {
        return $this->vals[$i];
    }

    internal const function at(usize $i) : Value?
    {
        if ($i >= $this->vals->count()) {
            return null;
        }

        return $this->vals[$i];
    }

    internal function slot(usize $i) : Value&
    {
        if ($i >= $this->vals->count()) {
            return &Value::$absent;
        }

        return &$this->vals[$i];
    }

    internal function set(usize $i, Value $value) : void
    {
        if ($i >= $this->vals->count()) {
            die('json::Value: index write past the end of the array');
        }

        $this->vals[$i] = $value;
    }

    internal function push(Value $value) : void
    {
        $this->vals[] = $value;
    }

    internal function remove(usize $i) : bool
    {
        if ($i >= $this->vals->count()) {
            return false;
        }

        $this->vals->remove($i);

        return true;
    }

    internal function clear() : void
    {
        $this->vals->clear();
    }

    internal const function copy() : array<Value>
    {
        array<Value> $vals = $this->vals;

        return $vals;
    }

    internal const function clone() : Items
    {
        Items $out = Items();
        usize $n = $this->vals->count();
        usize $i = 0;

        while ($i < $n) {
            $out->push($this->vals[$i]->clone());
            $i = $i + 1;
        }

        return $out;
    }
}

class Fields
{
    private ordered_map<string, Value> $vals;

    internal constructor()
    {
        $this->vals = ordered_map<string, Value>();
    }

    internal const function count() : usize
    {
        return $this->vals->count();
    }

    internal const function keys() : array<string>
    {
        return $this->vals->keys();
    }

    internal const function get(const string& $key) : Value?
    {
        if (!$this->vals->has($key)) {
            return null;
        }

        return $this->vals->get($key);
    }

    internal const function value(const string& $key) : Value
    {
        return $this->vals->get($key);
    }

    internal function slot(const string& $key) : Value&
    {
        if (!$this->vals->has($key)) {
            return &Value::$absent;
        }

        return $this->vals->at($key);
    }

    internal function set(const string& $key, Value $value) : void
    {
        $this->vals->set($key, $value);
    }

    internal const function has(const string& $key) : bool
    {
        return $this->vals->has($key);
    }

    internal function remove(const string& $key) : bool
    {
        return $this->vals->remove($key);
    }

    internal function clear() : void
    {
        $this->vals->clear();
    }

    internal const function copy() : ordered_map<string, Value>
    {
        ordered_map<string, Value> $vals = $this->vals;

        return $vals;
    }

    internal const function clone() : Fields
    {
        Fields $out = Fields();
        array<string> $keys = $this->vals->keys();
        usize $n = $keys->count();
        usize $i = 0;

        while ($i < $n) {
            string $key = $keys[$i];

            $out->set($key, $this->vals->get($key)->clone());
            $i = $i + 1;
        }

        return $out;
    }
}

/**
 * Case names stay distinct from the constructor methods (`nil`, `bool`, `int`, `str`,
 * `arr` / `array`, `object`) so an enum case and a static of the same arity can both
 * exist. Matching `list` / `obj` binds the share-box. Those types are module-internal,
 * and their methods are `internal`, so a second module that matches a case cannot
 * mutate the box.
 */
public enum Value
{
    case none;
    case boolean(bool $v);
    case integer(int64 $n);
    case floating(float64 $n);
    case text(string $s);
    case list(Items $items);
    case obj(Fields $fields);

    /**
     * The place a missing-key / missing-index read hands back. One JSON `null` the type owns,
     * because `[]` has to return a `Value&` and `&Value::$absent` is that place.
     *
     * `$v['nope']->asStr()` is the supported read. `$v['nope'] = 1` goes through `[]=` and
     * inserts. Handing the place to a `Value&` parameter writes this static — Echo has no
     * other slot to hand back. Do not do that.
     */
    internal static Value $absent = Value::none;

    // ---- constructors ---------------------------------------------------------------------------

    /** JSON `null`. Named `nil` because `null` is reserved. */
    public static function nil() : Value
    {
        return Value::none;
    }

    public static function bool(bool $v) : Value
    {
        return Value::boolean($v);
    }

    public static function int(int64 $n) : Value
    {
        return Value::integer($n);
    }

    public static function float(float64 $n) : Value
    {
        return Value::floating($n);
    }

    public static function str(const string& $s) : Value
    {
        return Value::text($s);
    }

    /**
     * An empty JSON array. Named `arr` because `array` is already the container type, and a
     * function of that name in this namespace would steal every `array<T>` spelling.
     */
    public static function arr() : Value
    {
        return Value::list(Items());
    }

    /**
     * Same as `arr`. The leading-dot spelling `.array()` is safe: the name lives on `Value`, so it
     * does not hide the root `array<T>` type the way a free `json::array()` would.
     */
    public static function array() : Value
    {
        return Value::arr();
    }

    public static function object() : Value
    {
        return Value::obj(Fields());
    }

    /**
     * An array holding `$vals` in order. A literal fills an `array<Value>` here, converting each
     * element on the way in, so this is how a mixed array is written: `json::arr(['echo', 1, true])`.
     */
    public static function arr(const array<Value>& $vals) : Value
    {
        return listOf($vals);
    }

    /**
     * Same as `arr($vals)`.
     */
    public static function array(const array<Value>& $vals) : Value
    {
        return listOf($vals);
    }

    /**
     * An object holding `$vals` in their order. A literal fills an `ordered_map<string, Value>` here,
     * so this is how a mixed object is written: `json::object(['name' => 'mario', 'id' => 32])`.
     */
    public static function object(const ordered_map<string, Value>& $vals) : Value
    {
        return objectOf($vals);
    }

    // ---- inbound conversions --------------------------------------------------------------------

    /**
     * A bare `1`, `'mario'`, `true` or `1.5` on the right of `[]=` becomes a `Value` here, so the
     * operators stay one overload each.
     */
    #[implicit]
    public static function from(int32 $n) : Value
    {
        return Value::int($n);
    }

    #[implicit]
    public static function from(int64 $n) : Value
    {
        return Value::int($n);
    }

    #[implicit]
    public static function from(float64 $n) : Value
    {
        return Value::float($n);
    }

    #[implicit]
    public static function from(bool $v) : Value
    {
        return Value::bool($v);
    }

    #[implicit]
    public static function from(string $s) : Value
    {
        return Value::str($s);
    }

    /**
     * An Echo container becomes an array or an object the same way, so `$user['tags'] = $tags`
     * needs no loop. A `map` has no order of its own, so its keys go in sorted, and two dumps of the
     * same map agree.
     *
     * Inbound conversions take their source by value and cannot be generic, hence one row per
     * element type.
     */
    #[implicit]
    public static function from(array<Value> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(array<string> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(array<int32> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(array<int64> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(array<float64> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(array<bool> $vals) : Value
    {
        return listOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, Value> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, string> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, int32> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, int64> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, float64> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(ordered_map<string, bool> $vals) : Value
    {
        return objectOf($vals);
    }

    #[implicit]
    public static function from(map<string, Value> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    #[implicit]
    public static function from(map<string, string> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    #[implicit]
    public static function from(map<string, int32> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    #[implicit]
    public static function from(map<string, int64> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    #[implicit]
    public static function from(map<string, float64> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    #[implicit]
    public static function from(map<string, bool> $vals) : Value
    {
        return sortedObjectOf($vals);
    }

    // ---- predicates -----------------------------------------------------------------------------

    public const function isNull() : bool
    {
        return match ($this) {
            Value::none => true,
            else => false,
        };
    }

    public const function isBool() : bool
    {
        return match ($this) {
            Value::boolean($v) => true,
            else => false,
        };
    }

    public const function isInt() : bool
    {
        return match ($this) {
            Value::integer($n) => true,
            else => false,
        };
    }

    public const function isFloat() : bool
    {
        return match ($this) {
            Value::floating($n) => true,
            else => false,
        };
    }

    public const function isNumber() : bool
    {
        return match ($this) {
            Value::integer($n) => true,
            Value::floating($n) => true,
            else => false,
        };
    }

    public const function isStr() : bool
    {
        return match ($this) {
            Value::text($s) => true,
            else => false,
        };
    }

    public const function isArray() : bool
    {
        return match ($this) {
            Value::list($items) => true,
            else => false,
        };
    }

    public const function isObject() : bool
    {
        return match ($this) {
            Value::obj($fields) => true,
            else => false,
        };
    }

    // ---- extractors -----------------------------------------------------------------------------

    public const function asBool() : bool?
    {
        match ($this) {
            Value::boolean($v) => {
                return $v;
            },
            else => {
                return null;
            },
        }
    }

    /** The integer, when this is an `int`. A `1.0` stays a float. */
    public const function asInt() : int64?
    {
        match ($this) {
            Value::integer($n) => {
                return $n;
            },
            else => {
                return null;
            },
        }
    }

    /** A float, or an int widened. */
    public const function asFloat() : float64?
    {
        match ($this) {
            Value::floating($f) => {
                return $f;
            },
            Value::integer($i) => {
                return widenInt($i);
            },
            else => {
                return null;
            },
        }
    }

    public const function asStr() : string?
    {
        match ($this) {
            Value::text($s) => {
                return $s;
            },
            else => {
                return null;
            },
        }
    }

    /**
     * A copy of the array. Children that are arrays or objects still share their box.
     */
    public const function asArray() : array<Value>?
    {
        match ($this) {
            Value::list($items) => {
                return $items->copy();
            },
            else => {
                return null;
            },
        }
    }

    /**
     * A copy of the object's map. Children that are arrays or objects still share their box.
     */
    public const function asObject() : ordered_map<string, Value>?
    {
        match ($this) {
            Value::obj($fields) => {
                return $fields->copy();
            },
            else => {
                return null;
            },
        }
    }

    // ---- lookup ---------------------------------------------------------------------------------

    /**
     * The value under `$key`, or Echo `null` when this is not an object or the key is missing.
     *
     * Echo `null` is not JSON `null`. `$v->get('x')->isNull()` after a present `"x": null` is true;
     * a missing key never reaches `isNull` because there is no value to ask.
     */
    public const function get(const string& $key) : Value?
    {
        match ($this) {
            Value::obj($fields) => {
                return $fields->get($key);
            },
            else => {
                return null;
            },
        }
    }

    /**
     * The element at `$i`, or Echo `null` when this is not an array or the index is past the end.
     */
    public const function at(usize $i) : Value?
    {
        match ($this) {
            Value::list($items) => {
                return $items->at($i);
            },
            else => {
                return null;
            },
        }
    }

    /**
     * The place `$v[$key]` names. A missing key, or a non-object, is `Value::$absent`.
     */
    internal function slot(const string& $key) : Value&
    {
        match ($this) {
            Value::obj($fields) => {
                return $fields->slot($key);
            },
            else => {
                return &Value::$absent;
            },
        }
    }

    /**
     * The place `$v[$i]` names. A bad index, or a non-array, is `Value::$absent`.
     */
    internal function slotAt(usize $i) : Value&
    {
        match ($this) {
            Value::list($items) => {
                return $items->slot($i);
            },
            else => {
                return &Value::$absent;
            },
        }
    }

    /**
     * Walks `$path` one segment at a time. On an object a segment is a key, taken verbatim. On an
     * array it is an index spelled the RFC 6901 way (`0`, or digits with no leading zero). Stops at
     * the first miss, the first segment an array cannot read as an index, or the first scalar.
     */
    public const function pick(const array<string>& $path) : Value?
    {
        Value $cur = $this;

        foreach ($path as const &$token) {
            Value $step = guard step($cur, $token) else {
                return null;
            }

            $cur = $step;
        }

        return $cur;
    }

    /**
     * Walks an RFC 6901 JSON Pointer such as `/users/0/name`. `''` is this value, and `~1` / `~0`
     * spell a `/` / `~` inside a key. A pointer that is not one (no leading `/`, a `~` not followed
     * by `0` or `1`) finds nothing, and so does `-`, which names the slot past the end.
     */
    public const function pick(const string& $pointer) : Value?
    {
        array<string> $path = guard tokens($pointer) else {
            return null;
        }

        return $this->pick($path);
    }

    /**
     * The object's keys, in order. Empty for every other kind. A copy of the key list only, not of
     * the values.
     */
    public const function keys() : array<string>
    {
        match ($this) {
            Value::obj($fields) => {
                return $fields->keys();
            },
            else => {
                return array<string>();
            },
        }
    }

    /**
     * A cursor over an array's elements, keyed by index. Nothing is copied: `as &$item` writes reach
     * the tree. Any other kind iterates zero times.
     *
     *     foreach ($v->elements() as $i => const &$item) { ... }
     */
    public const function elements() : Elements
    {
        match ($this) {
            Value::list($items) => {
                return Elements($items);
            },
            else => {
                return Elements(Items());
            },
        }
    }

    /**
     * A cursor over an object's members, keyed by name, in order. Only the key list is copied:
     * `as &$item` writes reach the tree. Any other kind iterates zero times.
     *
     *     foreach ($v->members() as $key => const &$item) { ... }
     */
    public const function members() : Members
    {
        match ($this) {
            Value::obj($fields) => {
                return Members($fields);
            },
            else => {
                return Members(Fields());
            },
        }
    }

    /**
     * Every leaf of this tree in one object, keyed by its JSON Pointer:
     * `{"a":{"b":[1]}}` flattens to `{"/a/b/0":1}`. An empty array or object is a leaf of its own,
     * so `unflatten` gives back exactly this tree. A scalar flattens to `{"": value}`.
     */
    public const function flatten() : Value
    {
        Fields $out = Fields();

        flattenInto($out, '', $this);

        return Value::obj($out);
    }

    /**
     * The tree a `flatten` came from. Each key is a JSON Pointer to where its value goes; an index
     * segment under a fresh node makes an array (a gap fills with `null`), anything else an object.
     */
    public const function unflatten() : result<Value, PointerError>
    {
        match ($this) {
            Value::obj($fields) => {
                return unflattenFields($fields);
            },
            else => {
                return .error(.notObject);
            },
        }
    }

    // ---- mutation -------------------------------------------------------------------------------

    /**
     * Stores `$value` under `$key`. This must be an object; anything else is a bug in the caller.
     */
    internal function set(const string& $key, Value $value) : void
    {
        match ($this) {
            Value::obj($fields) => {
                $fields->set($key, $value);
            },
            else => {
                die('json::Value: []= on a non-object');
            },
        }
    }

    /**
     * Replaces the element at `$i`. This must be an array and `$i` must be in range.
     */
    internal function setAt(usize $i, Value $value) : void
    {
        match ($this) {
            Value::list($items) => {
                $items->set($i, $value);
            },
            else => {
                die('json::Value: index write on a non-array');
            },
        }
    }

    /**
     * Appends `$value`. This must be an array; anything else is a bug in the caller.
     */
    internal function push(Value $value) : void
    {
        match ($this) {
            Value::list($items) => {
                $items->push($value);
            },
            else => {
                die('json::Value: append on a non-array');
            },
        }
    }

    /**
     * Removes the member `$key`. False when this is not an object or the key was not there.
     */
    public function remove(const string& $key) : bool
    {
        match ($this) {
            Value::obj($fields) => {
                return $fields->remove($key);
            },
            else => {
                return false;
            },
        }
    }

    /**
     * Removes the element at `$i`, shifting the rest down. False when this is not an array or `$i`
     * is past the end.
     */
    public function removeAt(usize $i) : bool
    {
        match ($this) {
            Value::list($items) => {
                return $items->remove($i);
            },
            else => {
                return false;
            },
        }
    }

    /**
     * Empties an array or object in place, so every alias of the box sees it empty. Does nothing to
     * a scalar.
     */
    public function clear() : void
    {
        match ($this) {
            Value::list($items) => {
                $items->clear();
            },
            Value::obj($fields) => {
                $fields->clear();
            },
            else => {},
        }
    }

    /**
     * Copies every member of `$other` in, overwriting a key this object already has. A rewritten
     * key keeps its place and a new one goes last. What comes in is cloned, so `$other` stays
     * independent. Both sides must be objects; anything else is a bug in the caller.
     */
    public function update(const Value& $other) : void
    {
        mergeInto(fieldsOf($this, 'update'), fieldsOf($other, 'update'), false);
    }

    /**
     * `update`, recursively: where both sides hold an object under the same key, that object is
     * merged rather than replaced. Everything else is overwritten with a clone.
     */
    public function merge(const Value& $other) : void
    {
        mergeInto(fieldsOf($this, 'merge'), fieldsOf($other, 'merge'), true);
    }

    /**
     * Appends a clone of every element of `$other`. Both sides must be arrays; anything else is a bug
     * in the caller.
     */
    public function extend(const Value& $other) : void
    {
        extendInto(itemsOf($this, 'extend'), itemsOf($other, 'extend'));
    }

    /**
     * How many entries this array or object holds. Zero for every other kind.
     */
    public const function count() : usize
    {
        return match ($this) {
            Value::list($items) => $items->count(),
            Value::obj($fields) => $fields->count(),
            else => 0,
        };
    }

    /**
     * A deep copy: a new node, and a new node for every child. Written out so `$b = $a` is never
     * mistaken for one.
     *
     * A cycle (only possible if you tie a node to an ancestor through `[]=`) overflows the stack,
     * the same way `dump` would.
     */
    public const function clone() : Value
    {
        match ($this) {
            Value::list($items) => {
                return cloneList($items);
            },
            Value::obj($fields) => {
                return cloneObject($fields);
            },
            else => {
                return $this;
            },
        }
    }
}

/**
 * A payload-binding match arm may not declare a local, so the two deep-copy arms call these.
 */
function cloneList(Items $items) : Value
{
    Items $copy = $items->clone();

    return Value::list($copy);
}

function cloneObject(Fields $fields) : Value
{
    Fields $copy = $fields->clone();

    return Value::obj($copy);
}

function widenInt(int64 $n) : float64
{
    float64 $wide = $n;

    return $wide;
}

public function nil() : Value
{
    return Value::nil();
}

public function bool(bool $v) : Value
{
    return Value::bool($v);
}

public function int(int64 $n) : Value
{
    return Value::int($n);
}

public function float(float64 $n) : Value
{
    return Value::float($n);
}

public function str(const string& $s) : Value
{
    return Value::str($s);
}

public function arr() : Value
{
    return Value::arr();
}

public function object() : Value
{
    return Value::object();
}

public function arr(const array<Value>& $vals) : Value
{
    return Value::arr($vals);
}

public function object(const ordered_map<string, Value>& $vals) : Value
{
    return Value::object($vals);
}
